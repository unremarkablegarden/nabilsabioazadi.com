{
  "format": "page",
  "id": "page",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "allowTargetBlank": true,
          "label": "Title",
          "multi": "heading1",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "body": {
        "config": {
          "allowTargetBlank": true,
          "label": "Body",
          "multi": "paragraph,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,list-item,o-list-item,embed",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "gallery": {
        "config": {
          "fields": {
            "image": {
              "config": {
                "constraint": {
                  "height": 1800,
                  "width": 2400
                },
                "label": "Image",
                "thumbnails": []
              },
              "type": "Image"
            },
            "caption": {
              "config": {
                "label": "Caption",
                "placeholder": ""
              },
              "type": "Text"
            }
          },
          "label": "Gallery",
          "repeat": true
        },
        "type": "Group"
      },
      "slices": {
        "config": {
          "choices": {}
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Page",
  "repeatable": true,
  "status": true
}